{
  "name": "deepseek-harness-design",
  "version": "0.5.2",
  "type": "module",
  "description": "Live HTML prototyping, element selection, and revision comparison for DeepSeek Harness",
  "files": [
    "host",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "README.zh-CN.md"
  ],
  "meta": {
    "title": "Harness Design",
    "description": "在对话里画前端原型：模型改稿，右侧 Design 标签页实时刷新，点选元素即可让模型精准修改。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/cordis-plugin-timer"
      ],
      "immediately": true
    }
  },
  "exports": {
    ".": "./host/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check host/index.js && node --check host/persistence.js && node --check client.js",
    "prepack": "npm test && npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/heureux831/deepseek-harness-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heureux831/deepseek-harness-design.git"
  },
  "bugs": {
    "url": "https://github.com/heureux831/deepseek-harness-design/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "plugin",
    "design",
    "prototype",
    "html"
  ],
  "author": "heureux831"
}
